#!/usr/bin/env bash
set -euo pipefail

case " $* " in
  *query1.finance.yahoo.com*)
    cat "$YAHOO_FIXTURE"
    ;;
  *api.telegram.org*)
    printf '%s\n' "$@" > "$TELEGRAM_REQUEST_LOG"
    printf '{"ok":true}\n'
    ;;
  *)
    printf 'Unexpected curl invocation: %s\n' "$*" >&2
    exit 1
    ;;
esac
